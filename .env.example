# Local OpenAI-compatible model endpoint. Start Ollama and pull the model separately.
OMNIPRESENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
OMNIPRESENT_LLM_MODEL=qwen3.5:4b
# Only needed for a local endpoint configured to require authentication:
# OMNIPRESENT_LLM_API_KEY=

# Normal live selection is local hybrid, with no decision model or paid fallback.
# Composition defaults to synthesis; explicit planner comparisons only:
# OMNIPRESENT_COMPOSITION_PLANNER=focus
# Optional hosted comparison credential; never required for normal live presentation:
# OPENROUTER_API_KEY=
