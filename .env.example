# Local-first Omnipresent configuration. Copy to .env for development.
# The native app stores model settings in a private settings.json in Application Support.

# Preparation agent: local Ollama / OpenAI-compatible endpoint.
OMNIPRESENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
OMNIPRESENT_LLM_MODEL=qwen3.5:4b
OMNIPRESENT_LLM_API_KEY=

# Presentation remains local-first; no decision model key is required.
OMNIPRESENT_COMPOSITION_PLANNER=synthesis
OMNIPRESENT_REQUIRE_INDEPENDENT_REVIEW=false

# Development server defaults. Desktop chooses a free loopback port and uses
# macOS Application Support for SQLite, uploaded materials and cached models.
PORT=4317

# Explicit hosted comparison only. May bill your provider account.
OPENROUTER_API_KEY=
