# Copy to .env (ignored by Git): cp .env.example .env
# npm run dev, npm run dev:server and npm start load this root file.
# Existing shell environment values take precedence.

# Preparation: local Ollama / OpenAI-compatible endpoint.
OMNIPRESENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
OMNIPRESENT_LLM_MODEL=qwen3.5:4b
# Optional authentication for your configured endpoint; leave blank locally.
OMNIPRESENT_LLM_API_KEY=

# Live presentation: local hybrid selection is fixed as the normal default.
# No decision model key is required. Planner: synthesis, focus, paired or stable.
OMNIPRESENT_COMPOSITION_PLANNER=synthesis
# Strict review mode rejects sources without independent review.
OMNIPRESENT_REQUIRE_INDEPENDENT_REVIEW=false

# Loopback coordinator port. The Vite proxy expects 4317 (see vite.config.ts).
PORT=4317
# Local persistence. Keep both paths outside tracked source.
# OMNIPRESENT_DB_PATH=output/omnipresent.db
# OMNIPRESENT_MATERIALS_PATH=output/materials
# Optional Python overrides, relative to the repository root or absolute paths:
# OMNIPRESENT_PYTHON=.venv/bin/python
# OMNIPRESENT_RETRIEVAL_PYTHON=output/retrieval-venv/bin/python

# Explicit hosted comparison only. May bill your provider account. Never required
# for normal live selection; credentials are never discovered in another app.
OPENROUTER_API_KEY=
# Optional Hugging Face token for model downloads; otherwise use local HF auth.
# HF_TOKEN=
