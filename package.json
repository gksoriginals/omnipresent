{
  "name": "omnipresent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "probe": "tsx scripts/probe.ts",
    "setup:speech": "uv venv --python 3.12 --python-preference only-managed .venv && uv pip sync --python .venv/bin/python runtime/requirements.lock",
    "probe:audio": "node scripts/prepare-audio.mjs",
    "probe:speech-loop": "node --import tsx scripts/speech-loop-probe.ts",
    "probe:visuals": "node --env-file-if-exists=.env --import tsx scripts/visual-agent-probe.ts",
    "trial:prepare": "node --env-file-if-exists=.env --import tsx scripts/prepare-adaptive-trial.ts && output/tts-venv/bin/python scripts/synthesize-trial.py",
    "trial:setup": "node scripts/setup-trial.mjs",
    "probe:renderers": "node --env-file-if-exists=.env --import tsx scripts/renderer-format-probe.ts",
    "decision:setup": "node scripts/setup-decisions.mjs",
    "decision:serve": "output/decision-venv/bin/python runtime/decision_server.py",
    "probe:decisions": "node --import tsx scripts/decision-model-probe.ts",
    "replay:baseline": "tsx scripts/replay-baseline.ts",
    "benchmark:controllers": "tsx scripts/controller-benchmark.ts",
    "retrieval:setup": "node scripts/setup-retrieval.mjs",
    "retrieval:serve": "output/retrieval-venv/bin/python runtime/retrieval_server.py",
    "benchmark:retrieval": "tsx scripts/retrieval-benchmark.ts",
    "benchmark:prediction": "tsx scripts/prediction-first-benchmark.ts",
    "validate:evidence": "node scripts/verify-validation.mjs",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.70",
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@openuidev/react-lang": "1.0.1",
    "ai": "7.0.142",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "description": "Local-first adaptive presentation canvas with evidence-scoped generative UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gksoriginals/omnipresent.git"
  },
  "bugs": {
    "url": "https://github.com/gksoriginals/omnipresent/issues"
  },
  "homepage": "https://github.com/gksoriginals/omnipresent#readme"
}
